server {
    listen {{ app_global.port }} default_server;
    listen [::]:{{ app_global.port }} default_server;

    server_name _;
    root {{ web_root }}/{{ app_global.directory }};
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        if (!-f $document_root/index.html) {
            return 503;
        }
        return 200 "OK";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen {{ zone.port }};
    listen [::]:{{ zone.port }};

    server_name _;
    root {{ web_root }}/{{ zone.directory }};
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        if (!-f $document_root/index.html) {
            return 503;
        }
        return 200 "OK";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}