<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="App Ganjil Zone service overview and network status.">
	<title>App Ganjil Zone</title>
	<style>
		:root {
			--ink: #17211b;
			--muted: #617067;
			--paper: #f5f7f1;
			--panel: #ffffff;
			--line: #dbe4d8;
			--green: #1f6b4a;
			--green-dark: #124331;
			--lime: #d8eea9;
			--coral: #e8795b;
			--shadow: 0 18px 45px rgba(23, 52, 36, 0.12);
		}

		* { box-sizing: border-box; }

		body {
			margin: 0;
			color: var(--ink);
			background:
				radial-gradient(circle at 90% 8%, rgba(216, 238, 169, 0.6), transparent 25rem),
				linear-gradient(135deg, #f5f7f1 0%, #edf4ea 100%);
			font-family: Georgia, 'Times New Roman', serif;
			min-height: 100vh;
		}

		.page {
			width: min(1080px, calc(100% - 40px));
			margin: 0 auto;
			padding: 28px 0 42px;
		}

		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
			margin-bottom: 74px;
			font-family: 'Trebuchet MS', sans-serif;
		}

		.brand {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			color: var(--green-dark);
			font-size: 0.9rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.brand-mark {
			display: grid;
			place-items: center;
			width: 34px;
			height: 34px;
			border-radius: 50%;
			color: var(--green-dark);
			background: var(--lime);
			font-weight: 900;
		}

		.zone {
			border: 1px solid var(--line);
			border-radius: 999px;
			padding: 9px 14px;
			color: var(--muted);
			background: rgba(255, 255, 255, 0.55);
			font-family: 'Trebuchet MS', sans-serif;
			font-size: 0.78rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.hero {
			display: grid;
			grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
			align-items: end;
			gap: 48px;
			margin-bottom: 58px;
		}

		.eyebrow {
			margin: 0 0 16px;
			color: var(--coral);
			font-family: 'Trebuchet MS', sans-serif;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.16em;
			text-transform: uppercase;
		}

		h1 {
			max-width: 700px;
			margin: 0;
			color: var(--green-dark);
			font-size: clamp(3.4rem, 9vw, 7.8rem);
			font-weight: 500;
			letter-spacing: -0.04em;
			line-height: 0.88;
		}

		.intro {
			max-width: 330px;
			margin: 0 0 5px;
			color: var(--muted);
			font-size: 1.1rem;
			line-height: 1.6;
		}

		.status {
			display: flex;
			align-items: center;
			gap: 9px;
			margin-top: 22px;
			color: var(--green);
			font-family: 'Trebuchet MS', sans-serif;
			font-size: 0.8rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.status-dot {
			width: 9px;
			height: 9px;
			border-radius: 50%;
			background: #54a864;
			box-shadow: 0 0 0 5px rgba(84, 168, 100, 0.16);
		}

		.overview {
			display: grid;
			grid-template-columns: 1.15fr 0.85fr;
			gap: 18px;
			margin-bottom: 18px;
		}

		.panel {
			border: 1px solid var(--line);
			border-radius: 16px;
			background: var(--panel);
			box-shadow: var(--shadow);
		}

		.mission {
			min-height: 250px;
			padding: 30px;
			background: var(--green-dark);
			color: #f4f8e8;
		}

		.panel-label {
			margin: 0 0 52px;
			color: var(--lime);
			font-family: 'Trebuchet MS', sans-serif;
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.14em;
			text-transform: uppercase;
		}

		.mission p {
			max-width: 560px;
			margin: 0;
			font-size: 1.55rem;
			line-height: 1.25;
		}

		.details {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1px;
			overflow: hidden;
			background: var(--line);
		}

		.detail {
			display: flex;
			min-height: 125px;
			flex-direction: column;
			justify-content: space-between;
			padding: 22px;
			background: var(--panel);
		}

		.detail span {
			color: var(--muted);
			font-family: 'Trebuchet MS', sans-serif;
			font-size: 0.72rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.detail strong {
			color: var(--green-dark);
			font-size: 1.35rem;
			font-weight: 500;
		}

		.network {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 22px;
			padding: 22px 28px;
		}

		.network-copy h2 {
			margin: 0 0 7px;
			color: var(--green-dark);
			font-size: 1.35rem;
			font-weight: 500;
		}

		.network-copy p {
			margin: 0;
			color: var(--muted);
			font-family: 'Trebuchet MS', sans-serif;
			font-size: 0.84rem;
		}

		.address {
			padding: 12px 16px;
			border-radius: 9px;
			color: var(--green-dark);
			background: var(--lime);
			font-family: 'Courier New', monospace;
			font-size: 0.92rem;
			white-space: nowrap;
		}

		footer {
			display: flex;
			justify-content: space-between;
			gap: 20px;
			margin-top: 52px;
			color: var(--muted);
			font-family: 'Trebuchet MS', sans-serif;
			font-size: 0.75rem;
		}

		@media (max-width: 720px) {
			.page { width: min(100% - 28px, 560px); padding-top: 18px; }
			.topbar { margin-bottom: 54px; }
			.hero, .overview { grid-template-columns: 1fr; gap: 28px; }
			h1 { font-size: clamp(3.6rem, 19vw, 6.5rem); }
			.mission { min-height: 220px; }
			.network { align-items: flex-start; flex-direction: column; }
			footer { flex-direction: column; margin-top: 36px; }
		}
	</style>
</head>
<body>
	<main class="page">
		<header class="topbar">
			<div class="brand"><span class="brand-mark">A</span> Anycast Lab</div>
			<div class="zone">Production zone / Ganjil</div>
		</header>

		<section class="hero" aria-labelledby="page-title">
			<div>
				<p class="eyebrow">Application network</p>
				<h1 id="page-title">App Ganjil Zone</h1>
			</div>
			<div>
				<p class="intro">A focused application zone for the Ganjil environment, built to stay clear, reachable, and ready for traffic.</p>
				<div class="status"><span class="status-dot"></span> Service ready</div>
			</div>
		</section>

		<section class="overview" aria-label="Zone overview">
			<article class="panel mission">
				<p class="panel-label">About this zone</p>
				<p>Reliable application delivery for workloads connected to the Ganjil network.</p>
			</article>

			<div class="panel details">
				<div class="detail"><span>Environment</span><strong>Ganjil</strong></div>
				<div class="detail"><span>Role</span><strong>Application</strong></div>
				<div class="detail"><span>Server Identity</span><strong>{{ ansible_host }}</strong></div>
				<div class="detail"><span>Access</span><strong>HTTP / HTTPS</strong></div>
			</div>
		</section>

		<section class="panel network" aria-label="Network details">
			<div class="network-copy">
				<h2>Connected to the Ganjil client network</h2>
				<p>Traffic is routed through the shared anycast service.</p>
			</div>
			<div class="address">{{ client_network }}</div>
		</section>

		<footer>
			<span>App Ganjil Zone</span>
			<span>Anycast service · 10.15.100.10</span>
		</footer>
	</main>
</body>
</html>
